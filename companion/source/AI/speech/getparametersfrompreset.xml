<?xml version='1.0' encoding='us-ascii'?>
<BehaviorTrees>
  <BehaviorTree name="speech_getParametersFromPreset" is_function="1">
    <Variables><Variable name="kcd2vrNoCameras" type="_bool" values="false" isPersistent="0" form="single" /></Variables>
    <Parameters>
      <Variable name="dialogParameters" type="dialog:parameters:initiator" values="" isPersistent="0" form="single" requirementType="Out" />
      <Variable name="preset" type="enum:dialogPreset" values="$enum:dialogPreset.fader" isPersistent="0" form="single" requirementType="In" />
    </Parameters>
    <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
      <Behavior canSkip="1">
        <Sequence><Switch>
          <IfCondition failOnCondition="false" condition="$preset==$enum:dialogPreset.fader">
            <Expression expressions="$dialogParameters.putDownCarriedBody = true&#10;$dialogParameters.enableGreeting = false &#10;$dialogParameters.enableEnding = false" />
          </IfCondition>
          <IfCondition failOnCondition="false" condition="$preset==$enum:dialogPreset.ingame">
            <Expression expressions="$dialogParameters.useTwinsAsInitiator = false" />
          </IfCondition>
          <IfCondition failOnCondition="false" condition="$preset == $enum:dialogPreset.chat">
            <Expression expressions="$dialogParameters.chat = true &#10;$dialogParameters.enableGreeting = false &#10;$dialogParameters.enableEnding = false &#10;$dialogParameters.useTwinsAsInitiator = false" />
          </IfCondition>
          <DefaultBranch>
            <ErrorNode Message="'UNKNOWN PRESET'" />
          </DefaultBranch>
        </Switch>
      <ExecuteLua code="data.kcd2vrNoCameras = (System.GetCVar('wh_dlg_NoCameras') == 1)" /><IfCondition failOnCondition="false" condition="$kcd2vrNoCameras &amp; $preset==$enum:dialogPreset.fader"><Expression expressions="$dialogParameters.movePlayer = false&#10;$dialogParameters.rotatePlayer = false" /></IfCondition></Sequence></Behavior>
    </Root>
    <ForestContainer />
    <EditorData EventSet="">
      <Variables>
        <Variable name="dialogParameters" comment="" />
        <Variable name="preset" comment="" />
      <Variable name="kcd2vrNoCameras" comment="NoCameras uses stock original-actor dialogue path." /></Variables>
      <ForwardDeclarations />
      <Root hasInputBreakpoint="0" comment="" breakpointFlags="0" saveVersion="2">
        <OutputBreakpoints />
        <Behavior>
          <Sequence><Switch hasInputBreakpoint="0" comment="" breakpointFlags="0">
            <OutputBreakpoints />
            <IfCondition hasInputBreakpoint="0" comment="" breakpointFlags="0">
              <OutputBreakpoints />
              <Expression hasInputBreakpoint="0" comment="" breakpointFlags="0">
                <OutputBreakpoints />
              </Expression>
            </IfCondition>
            <IfCondition hasInputBreakpoint="0" comment="" breakpointFlags="0">
              <OutputBreakpoints />
              <Expression hasInputBreakpoint="0" comment="" breakpointFlags="0">
                <OutputBreakpoints />
              </Expression>
            </IfCondition>
            <IfCondition hasInputBreakpoint="0" comment="" breakpointFlags="0">
              <OutputBreakpoints />
              <Expression hasInputBreakpoint="0" comment="" breakpointFlags="0">
                <OutputBreakpoints />
              </Expression>
            </IfCondition>
            <DefaultBranch>
              <ErrorNode hasInputBreakpoint="0" comment="" breakpointFlags="0">
                <OutputBreakpoints />
              </ErrorNode>
            </DefaultBranch>
          </Switch>
        <ExecuteLua /><IfCondition><Expression /></IfCondition></Sequence></Behavior>
      </Root>
